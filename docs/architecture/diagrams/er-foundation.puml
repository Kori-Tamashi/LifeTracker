@startuml
skinparam backgroundColor white
hide methods
hide stereotypes
skinparam shadowing false
left to right direction
title er-foundation / physical schema v1 (baseline 1.0)
entity "profiles" as profiles {
  * id : TEXT
  timezone : TEXT
  active : INTEGER
}
entity "entities" as entities {
  * profile_id : TEXT
  * id : TEXT
  kind : TEXT
  current_revision : INTEGER
}
entity "revisions" as revisions {
  * profile_id : TEXT
  * entity_id : TEXT
  * revision : INTEGER
  recorded_ms : INTEGER
  actor : TEXT
  status : TEXT
  reason : TEXT
}
entity "source_events" as source_events {
  * profile_id : TEXT
  * id : TEXT
  source : TEXT
  external_id : TEXT
  payload_hash : TEXT
  received_ms : INTEGER
  state : TEXT
  receipt_json : TEXT
}
entity "media" as media {
  * profile_id : TEXT
  * id : TEXT
  relative_path : TEXT
  sha256 : TEXT
  bytes : INTEGER
  mime : TEXT
  lifecycle : TEXT
  retention_after_ms : INTEGER
  pin_count : INTEGER
}
entity "evidence" as evidence {
  * profile_id : TEXT
  * id : TEXT
  episode_id : TEXT
  source_event_id : TEXT
  media_id : TEXT
  excerpt : TEXT
  original_available : INTEGER
}
entity "revision_evidence" as revision_evidence {
  * profile_id : TEXT
  * entity_id : TEXT
  * revision : INTEGER
  * evidence_id : TEXT
}
entity "dependencies" as dependencies {
  * profile_id : TEXT
  * dependent_id : TEXT
  * dependent_revision : INTEGER
  * basis_id : TEXT
  * basis_revision : INTEGER
}
entity "jobs" as jobs {
  * profile_id : TEXT
  * id : TEXT
  kind : TEXT
  idempotency_key : TEXT
  state : TEXT
  ready_ms : INTEGER
  attempts : INTEGER
  lease_owner : TEXT
  lease_until_ms : INTEGER
  fence : INTEGER
}
entity "outbox" as outbox {
  * profile_id : TEXT
  * id : TEXT
  reason_key : TEXT
  topic : TEXT
  created_ms : INTEGER
  dispatched_ms : INTEGER
}
entity "integration_state" as integration_state {
  * profile_id : TEXT
  * provider : TEXT
  * capability : TEXT
  state : TEXT
  checkpoint : TEXT
  last_success_ms : INTEGER
  error_code : TEXT
}
entity "notification_events" as notification_events {
  * profile_id : TEXT
  * id : TEXT
  reason_key : TEXT
  kind : TEXT
  local_day : TEXT
  slot : INTEGER
  consumes_quota : INTEGER
  expires_ms : INTEGER
}
entity "deliveries" as deliveries {
  * profile_id : TEXT
  * event_id : TEXT
  * channel : TEXT
  state : TEXT
  attempts : INTEGER
  external_message_id : TEXT
}
entity "backup_manifests" as backup_manifests {
  * id : TEXT
  state : TEXT
  created_ms : INTEGER
  schema_version : INTEGER
  relative_path : TEXT
  sha256 : TEXT
  verification_ms : INTEGER
}
entity "search_entries" as search_entries {
  profile_id : FTS5
  entity_id : FTS5
  revision : FTS5
  episode_id : FTS5
  content : FTS5
}
entities }o--|| revisions
entities }o--|| profiles
revisions }o--|| entities
source_events }o--|| profiles
media }o--|| profiles
evidence }o--|| media
evidence }o--|| entities
evidence }o--|| source_events
evidence }o--|| profiles
revision_evidence }o--|| evidence
revision_evidence }o--|| revisions
dependencies }o--|| revisions
jobs }o--|| profiles
outbox }o--|| profiles
integration_state }o--|| profiles
notification_events }o--|| profiles
deliveries }o--|| notification_events
@enduml
