<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP08_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP08" name="Фото блюда и оценка питания" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-02, ALG-09</bpmn:documentation>
    <bpmn:laneSet id="BP08_LaneSet">
      <bpmn:lane id="BP08_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP08_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP08_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP08_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP08_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP08_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP08_enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP08_after</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP08_unknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP08_save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP08_Lane2" name="Локальный ИИ">
        <bpmn:flowNodeRef>BP08_vision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP08_Lane3" name="Правила питания">
        <bpmn:flowNodeRef>BP08_calc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP08_s" name="Фото блюда">
      <bpmn:outgoing>BP08_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP08_accept" name="Принять фото durable">
      <bpmn:incoming>BP08_F1</bpmn:incoming>
      <bpmn:outgoing>BP08_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP08_vision" name="Предложить состав и порцию">
      <bpmn:incoming>BP08_F2</bpmn:incoming>
      <bpmn:outgoing>BP08_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP08_enough" name="Данных достаточно?" gatewayDirection="Diverging" default="BP08_F5">
      <bpmn:incoming>BP08_F3</bpmn:incoming>
      <bpmn:outgoing>BP08_F4</bpmn:outgoing>
      <bpmn:outgoing>BP08_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BP08_ask" name="Уточнить массу / состав ≤2 раза">
      <bpmn:incoming>BP08_F5</bpmn:incoming>
      <bpmn:outgoing>BP08_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BP08_after" name="Теперь достаточно?" gatewayDirection="Diverging" default="BP08_F8">
      <bpmn:incoming>BP08_F6</bpmn:incoming>
      <bpmn:outgoing>BP08_F7</bpmn:outgoing>
      <bpmn:outgoing>BP08_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP08_unknown" name="Сохранить без КБЖУ">
      <bpmn:incoming>BP08_F8</bpmn:incoming>
      <bpmn:outgoing>BP08_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BP08_calc" name="Оценить диапазон по справочнику">
      <bpmn:incoming>BP08_F4</bpmn:incoming>
      <bpmn:incoming>BP08_F7</bpmn:incoming>
      <bpmn:outgoing>BP08_F9</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="BP08_save" name="Сохранить допущения / источники">
      <bpmn:incoming>BP08_F9</bpmn:incoming>
      <bpmn:incoming>BP08_F10</bpmn:incoming>
      <bpmn:outgoing>BP08_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP08_e" name="Блюдо записано">
      <bpmn:incoming>BP08_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP08_F1" sourceRef="BP08_s" targetRef="BP08_accept" />
    <bpmn:sequenceFlow id="BP08_F2" sourceRef="BP08_accept" targetRef="BP08_vision" />
    <bpmn:sequenceFlow id="BP08_F3" sourceRef="BP08_vision" targetRef="BP08_enough" />
    <bpmn:sequenceFlow id="BP08_F4" sourceRef="BP08_enough" targetRef="BP08_calc" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP08_F5" sourceRef="BP08_enough" targetRef="BP08_ask" name="нет" />
    <bpmn:sequenceFlow id="BP08_F6" sourceRef="BP08_ask" targetRef="BP08_after" />
    <bpmn:sequenceFlow id="BP08_F7" sourceRef="BP08_after" targetRef="BP08_calc" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP08_F8" sourceRef="BP08_after" targetRef="BP08_unknown" name="нет" />
    <bpmn:sequenceFlow id="BP08_F9" sourceRef="BP08_calc" targetRef="BP08_save" />
    <bpmn:sequenceFlow id="BP08_F10" sourceRef="BP08_unknown" targetRef="BP08_save" />
    <bpmn:sequenceFlow id="BP08_F11" sourceRef="BP08_save" targetRef="BP08_e" />
  </bpmn:process>
