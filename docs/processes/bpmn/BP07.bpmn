<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP07_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP07" name="Резервирование и проверка восстановления" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-10</bpmn:documentation>
    <bpmn:laneSet id="BP07_LaneSet">
      <bpmn:lane id="BP07_Lane0" name="Планировщик">
        <bpmn:flowNodeRef>BP07_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_warn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP07_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP07_preflight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_restored</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_rotation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP07_Lane2" name="Хранилище">
        <bpmn:flowNodeRef>BP07_snapshot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP07_restore</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP07_s" name="Срок копии / миграция">
      <bpmn:outgoing>BP07_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP07_preflight" name="Проверить место и media pin">
      <bpmn:incoming>BP07_F1</bpmn:incoming>
      <bpmn:outgoing>BP07_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP07_snapshot" name="Сделать snapshot БД + медиа">
      <bpmn:incoming>BP07_F2</bpmn:incoming>
      <bpmn:outgoing>BP07_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP07_validate" name="Проверить manifest / hashes">
      <bpmn:incoming>BP07_F3</bpmn:incoming>
      <bpmn:outgoing>BP07_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP07_ok" name="Копия целостна?" gatewayDirection="Diverging" default="BP07_F6">
      <bpmn:incoming>BP07_F4</bpmn:incoming>
      <bpmn:outgoing>BP07_F5</bpmn:outgoing>
      <bpmn:outgoing>BP07_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BP07_fail" name="Ошибка: старые копии сохранены">
      <bpmn:incoming>BP07_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BP07_complete" name="Пометить completed">
      <bpmn:incoming>BP07_F5</bpmn:incoming>
      <bpmn:outgoing>BP07_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP07_restore" name="Тест restore в отдельный каталог">
      <bpmn:incoming>BP07_F7</bpmn:incoming>
      <bpmn:outgoing>BP07_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP07_restored" name="Restore успешен?" gatewayDirection="Diverging" default="BP07_F10">
      <bpmn:incoming>BP07_F8</bpmn:incoming>
      <bpmn:outgoing>BP07_F9</bpmn:outgoing>
      <bpmn:outgoing>BP07_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP07_rotation" name="Ротация и освобождение pin">
      <bpmn:incoming>BP07_F9</bpmn:incoming>
      <bpmn:outgoing>BP07_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP07_e" name="Копия готова">
      <bpmn:incoming>BP07_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="BP07_warn" name="Копия не допущена к ротации">
      <bpmn:incoming>BP07_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP07_F1" sourceRef="BP07_s" targetRef="BP07_preflight" />
    <bpmn:sequenceFlow id="BP07_F2" sourceRef="BP07_preflight" targetRef="BP07_snapshot" />
    <bpmn:sequenceFlow id="BP07_F3" sourceRef="BP07_snapshot" targetRef="BP07_validate" />
    <bpmn:sequenceFlow id="BP07_F4" sourceRef="BP07_validate" targetRef="BP07_ok" />
    <bpmn:sequenceFlow id="BP07_F5" sourceRef="BP07_ok" targetRef="BP07_complete" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP07_F6" sourceRef="BP07_ok" targetRef="BP07_fail" name="нет" />
    <bpmn:sequenceFlow id="BP07_F7" sourceRef="BP07_complete" targetRef="BP07_restore" />
    <bpmn:sequenceFlow id="BP07_F8" sourceRef="BP07_restore" targetRef="BP07_restored" />
    <bpmn:sequenceFlow id="BP07_F9" sourceRef="BP07_restored" targetRef="BP07_rotation" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP07_F10" sourceRef="BP07_restored" targetRef="BP07_warn" name="нет" />
    <bpmn:sequenceFlow id="BP07_F11" sourceRef="BP07_rotation" targetRef="BP07_e" />
  </bpmn:process>
