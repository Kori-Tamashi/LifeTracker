<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP01_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP01" name="Самооценка и текущий баланс" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-01, ALG-04</bpmn:documentation>
    <bpmn:laneSet id="BP01_LaneSet">
      <bpmn:lane id="BP01_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP01_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP01_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP01_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_full</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_balance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP01_unknown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP01_s" name="Новая отметка">
      <bpmn:outgoing>BP01_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="BP01_enter" name="Ввести часть показателей">
      <bpmn:incoming>BP01_F1</bpmn:incoming>
      <bpmn:outgoing>BP01_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BP01_validate" name="Проверить диапазон и время">
      <bpmn:incoming>BP01_F2</bpmn:incoming>
      <bpmn:incoming>BP01_F6</bpmn:incoming>
      <bpmn:outgoing>BP01_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP01_ok" name="Ввод корректен?" gatewayDirection="Diverging" default="BP01_F5">
      <bpmn:incoming>BP01_F3</bpmn:incoming>
      <bpmn:outgoing>BP01_F4</bpmn:outgoing>
      <bpmn:outgoing>BP01_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BP01_fix" name="Исправить ввод">
      <bpmn:incoming>BP01_F5</bpmn:incoming>
      <bpmn:outgoing>BP01_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BP01_save" name="Сохранить ревизии атомарно">
      <bpmn:incoming>BP01_F4</bpmn:incoming>
      <bpmn:outgoing>BP01_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BP01_calc" name="Выбрать источники и TTL">
      <bpmn:incoming>BP01_F7</bpmn:incoming>
      <bpmn:outgoing>BP01_F8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="BP01_full" name="Все показатели известны?" gatewayDirection="Diverging" default="BP01_F10">
      <bpmn:incoming>BP01_F8</bpmn:incoming>
      <bpmn:outgoing>BP01_F9</bpmn:outgoing>
      <bpmn:outgoing>BP01_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BP01_balance" name="Рассчитать минимум и уровень">
      <bpmn:incoming>BP01_F9</bpmn:incoming>
      <bpmn:outgoing>BP01_F11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="BP01_unknown" name="Показать известное / unknown">
      <bpmn:incoming>BP01_F10</bpmn:incoming>
      <bpmn:outgoing>BP01_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP01_end" name="Состояние показано">
      <bpmn:incoming>BP01_F11</bpmn:incoming>
      <bpmn:incoming>BP01_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP01_F1" sourceRef="BP01_s" targetRef="BP01_enter" />
    <bpmn:sequenceFlow id="BP01_F2" sourceRef="BP01_enter" targetRef="BP01_validate" />
    <bpmn:sequenceFlow id="BP01_F3" sourceRef="BP01_validate" targetRef="BP01_ok" />
    <bpmn:sequenceFlow id="BP01_F4" sourceRef="BP01_ok" targetRef="BP01_save" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP01_F5" sourceRef="BP01_ok" targetRef="BP01_fix" name="нет" />
    <bpmn:sequenceFlow id="BP01_F6" sourceRef="BP01_fix" targetRef="BP01_validate" name="повтор" />
    <bpmn:sequenceFlow id="BP01_F7" sourceRef="BP01_save" targetRef="BP01_calc" />
    <bpmn:sequenceFlow id="BP01_F8" sourceRef="BP01_calc" targetRef="BP01_full" />
    <bpmn:sequenceFlow id="BP01_F9" sourceRef="BP01_full" targetRef="BP01_balance" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP01_F10" sourceRef="BP01_full" targetRef="BP01_unknown" name="нет" />
    <bpmn:sequenceFlow id="BP01_F11" sourceRef="BP01_balance" targetRef="BP01_end" />
    <bpmn:sequenceFlow id="BP01_F12" sourceRef="BP01_unknown" targetRef="BP01_end" />
  </bpmn:process>
