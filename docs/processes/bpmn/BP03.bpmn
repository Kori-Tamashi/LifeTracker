<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP03_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP03" name="Исправление факта и зависимых выводов" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-04</bpmn:documentation>
    <bpmn:laneSet id="BP03_LaneSet">
      <bpmn:lane id="BP03_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP03_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP03_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP03_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_current</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_rebuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_effects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP03_index</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP03_s" name="Ошибка факта обнаружена">
      <bpmn:outgoing>BP03_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="BP03_edit" name="Исправить факт / причину">
      <bpmn:incoming>BP03_F1</bpmn:incoming>
      <bpmn:incoming>BP03_F6</bpmn:incoming>
      <bpmn:outgoing>BP03_F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BP03_check" name="Проверить expected revision">
      <bpmn:incoming>BP03_F2</bpmn:incoming>
      <bpmn:outgoing>BP03_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP03_current" name="Версия актуальна?" gatewayDirection="Diverging" default="BP03_F5">
      <bpmn:incoming>BP03_F3</bpmn:incoming>
      <bpmn:outgoing>BP03_F4</bpmn:outgoing>
      <bpmn:outgoing>BP03_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BP03_conflict" name="Просмотреть конфликт версий">
      <bpmn:incoming>BP03_F5</bpmn:incoming>
      <bpmn:outgoing>BP03_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BP03_commit" name="Новая ревизия и stale связей">
      <bpmn:incoming>BP03_F4</bpmn:incoming>
      <bpmn:outgoing>BP03_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP03_rebuild" name="Пересчитать граф зависимостей">
      <bpmn:incoming>BP03_F7</bpmn:incoming>
      <bpmn:outgoing>BP03_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP03_effects" name="Компенсировать игровые эффекты">
      <bpmn:incoming>BP03_F8</bpmn:incoming>
      <bpmn:outgoing>BP03_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP03_index" name="Обновить индекс и объяснения">
      <bpmn:incoming>BP03_F9</bpmn:incoming>
      <bpmn:outgoing>BP03_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP03_e" name="История и результат доступны">
      <bpmn:incoming>BP03_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP03_F1" sourceRef="BP03_s" targetRef="BP03_edit" />
    <bpmn:sequenceFlow id="BP03_F2" sourceRef="BP03_edit" targetRef="BP03_check" />
    <bpmn:sequenceFlow id="BP03_F3" sourceRef="BP03_check" targetRef="BP03_current" />
    <bpmn:sequenceFlow id="BP03_F4" sourceRef="BP03_current" targetRef="BP03_commit" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP03_F5" sourceRef="BP03_current" targetRef="BP03_conflict" name="нет" />
    <bpmn:sequenceFlow id="BP03_F6" sourceRef="BP03_conflict" targetRef="BP03_edit" name="повтор с новой версией" />
    <bpmn:sequenceFlow id="BP03_F7" sourceRef="BP03_commit" targetRef="BP03_rebuild" />
    <bpmn:sequenceFlow id="BP03_F8" sourceRef="BP03_rebuild" targetRef="BP03_effects" />
    <bpmn:sequenceFlow id="BP03_F9" sourceRef="BP03_effects" targetRef="BP03_index" />
    <bpmn:sequenceFlow id="BP03_F10" sourceRef="BP03_index" targetRef="BP03_e" />
  </bpmn:process>
