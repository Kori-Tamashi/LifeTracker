<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP02_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP02" name="Голосовой дневник и принятие записей" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-02, ALG-03, ALG-05</bpmn:documentation>
    <bpmn:laneSet id="BP02_LaneSet">
      <bpmn:lane id="BP02_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP02_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP02_intake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP02_memory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP02_Lane2" name="Локальный ИИ">
        <bpmn:flowNodeRef>BP02_infer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP02_s" name="Голосовое сообщение">
      <bpmn:outgoing>BP02_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP02_intake" name="Durable приём и dedup">
      <bpmn:incoming>BP02_F1</bpmn:incoming>
      <bpmn:outgoing>BP02_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP02_infer" name="Распознать и извлечь">
      <bpmn:incoming>BP02_F2</bpmn:incoming>
      <bpmn:outgoing>BP02_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP02_valid" name="Результат валиден?" gatewayDirection="Diverging" default="BP02_F5">
      <bpmn:incoming>BP02_F3</bpmn:incoming>
      <bpmn:outgoing>BP02_F4</bpmn:outgoing>
      <bpmn:outgoing>BP02_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP02_retry" name="Сохранить retry / failed">
      <bpmn:incoming>BP02_F5</bpmn:incoming>
      <bpmn:outgoing>BP02_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP02_auto" name="Автоподтверждение?" gatewayDirection="Diverging" default="BP02_F8">
      <bpmn:incoming>BP02_F4</bpmn:incoming>
      <bpmn:outgoing>BP02_F7</bpmn:outgoing>
      <bpmn:outgoing>BP02_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BP02_confirm" name="Подтвердить / исправить">
      <bpmn:incoming>BP02_F8</bpmn:incoming>
      <bpmn:outgoing>BP02_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BP02_accepted" name="Записи приняты?" gatewayDirection="Diverging" default="BP02_F11">
      <bpmn:incoming>BP02_F9</bpmn:incoming>
      <bpmn:outgoing>BP02_F10</bpmn:outgoing>
      <bpmn:outgoing>BP02_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP02_store" name="Commit записей и Evidence">
      <bpmn:incoming>BP02_F7</bpmn:incoming>
      <bpmn:incoming>BP02_F10</bpmn:incoming>
      <bpmn:outgoing>BP02_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP02_memory" name="Обновить память / ответ">
      <bpmn:incoming>BP02_F12</bpmn:incoming>
      <bpmn:outgoing>BP02_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP02_e" name="Результат доступен">
      <bpmn:incoming>BP02_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="BP02_re" name="Ожидание повтора / исправления">
      <bpmn:incoming>BP02_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="BP02_reject" name="Извлечение отклонено">
      <bpmn:incoming>BP02_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP02_F1" sourceRef="BP02_s" targetRef="BP02_intake" />
    <bpmn:sequenceFlow id="BP02_F2" sourceRef="BP02_intake" targetRef="BP02_infer" name="job lease" />
    <bpmn:sequenceFlow id="BP02_F3" sourceRef="BP02_infer" targetRef="BP02_valid" />
    <bpmn:sequenceFlow id="BP02_F4" sourceRef="BP02_valid" targetRef="BP02_auto" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP02_F5" sourceRef="BP02_valid" targetRef="BP02_retry" name="нет" />
    <bpmn:sequenceFlow id="BP02_F6" sourceRef="BP02_retry" targetRef="BP02_re" />
    <bpmn:sequenceFlow id="BP02_F7" sourceRef="BP02_auto" targetRef="BP02_store" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP02_F8" sourceRef="BP02_auto" targetRef="BP02_confirm" name="нет" />
    <bpmn:sequenceFlow id="BP02_F9" sourceRef="BP02_confirm" targetRef="BP02_accepted" />
    <bpmn:sequenceFlow id="BP02_F10" sourceRef="BP02_accepted" targetRef="BP02_store" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP02_F11" sourceRef="BP02_accepted" targetRef="BP02_reject" name="нет" />
    <bpmn:sequenceFlow id="BP02_F12" sourceRef="BP02_store" targetRef="BP02_memory" />
    <bpmn:sequenceFlow id="BP02_F13" sourceRef="BP02_memory" targetRef="BP02_e" />
  </bpmn:process>
