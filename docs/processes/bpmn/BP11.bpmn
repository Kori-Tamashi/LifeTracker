<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP11_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP11" name="Портфель и объяснимый расчёт доходности" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-06, ALG-11</bpmn:documentation>
    <bpmn:laneSet id="BP11_LaneSet">
      <bpmn:lane id="BP11_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP11_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP11_Lane1" name="Инвестиционное ядро">
        <bpmn:flowNodeRef>BP11_reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_basis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_unknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_report</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP11_Lane2" name="Источники">
        <bpmn:flowNodeRef>BP11_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP11_ambiguous</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP11_s" name="Запрос портфеля">
      <bpmn:outgoing>BP11_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP11_load" name="Взять trades / flows / quotes">
      <bpmn:incoming>BP11_F1</bpmn:incoming>
      <bpmn:outgoing>BP11_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BP11_reconcile" name="Сверить позиции и corporate actions">
      <bpmn:incoming>BP11_F2</bpmn:incoming>
      <bpmn:outgoing>BP11_F3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="BP11_basis" name="Есть основания расчёта?" gatewayDirection="Diverging" default="BP11_F5">
      <bpmn:incoming>BP11_F3</bpmn:incoming>
      <bpmn:outgoing>BP11_F4</bpmn:outgoing>
      <bpmn:outgoing>BP11_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP11_unknown" name="Coverage partial / unavailable">
      <bpmn:incoming>BP11_F5</bpmn:incoming>
      <bpmn:outgoing>BP11_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BP11_method" name="Выбрать TWR / Dietz / MWR">
      <bpmn:incoming>BP11_F4</bpmn:incoming>
      <bpmn:outgoing>BP11_F7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="BP11_calc" name="Рассчитать по версии метода">
      <bpmn:incoming>BP11_F7</bpmn:incoming>
      <bpmn:outgoing>BP11_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP11_valid" name="Результат однозначен?" gatewayDirection="Diverging" default="BP11_F10">
      <bpmn:incoming>BP11_F8</bpmn:incoming>
      <bpmn:outgoing>BP11_F9</bpmn:outgoing>
      <bpmn:outgoing>BP11_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP11_ambiguous" name="Отметить unknown / ambiguous">
      <bpmn:incoming>BP11_F10</bpmn:incoming>
      <bpmn:outgoing>BP11_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP11_store" name="Сохранить inputs / method / coverage">
      <bpmn:incoming>BP11_F6</bpmn:incoming>
      <bpmn:incoming>BP11_F9</bpmn:incoming>
      <bpmn:incoming>BP11_F11</bpmn:incoming>
      <bpmn:outgoing>BP11_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP11_report" name="Отчёт: P&amp;L / fees / tax ledger">
      <bpmn:incoming>BP11_F12</bpmn:incoming>
      <bpmn:outgoing>BP11_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP11_e" name="Объяснение доступно">
      <bpmn:incoming>BP11_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP11_F1" sourceRef="BP11_s" targetRef="BP11_load" />
    <bpmn:sequenceFlow id="BP11_F2" sourceRef="BP11_load" targetRef="BP11_reconcile" />
    <bpmn:sequenceFlow id="BP11_F3" sourceRef="BP11_reconcile" targetRef="BP11_basis" />
    <bpmn:sequenceFlow id="BP11_F4" sourceRef="BP11_basis" targetRef="BP11_method" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP11_F5" sourceRef="BP11_basis" targetRef="BP11_unknown" name="нет" />
    <bpmn:sequenceFlow id="BP11_F6" sourceRef="BP11_unknown" targetRef="BP11_store" />
    <bpmn:sequenceFlow id="BP11_F7" sourceRef="BP11_method" targetRef="BP11_calc" />
    <bpmn:sequenceFlow id="BP11_F8" sourceRef="BP11_calc" targetRef="BP11_valid" />
    <bpmn:sequenceFlow id="BP11_F9" sourceRef="BP11_valid" targetRef="BP11_store" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP11_F10" sourceRef="BP11_valid" targetRef="BP11_ambiguous" name="нет" />
    <bpmn:sequenceFlow id="BP11_F11" sourceRef="BP11_ambiguous" targetRef="BP11_store" />
    <bpmn:sequenceFlow id="BP11_F12" sourceRef="BP11_store" targetRef="BP11_report" />
    <bpmn:sequenceFlow id="BP11_F13" sourceRef="BP11_report" targetRef="BP11_e" />
  </bpmn:process>
