<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP05_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP05" name="Автономные квесты и игровые последствия" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-07</bpmn:documentation>
    <bpmn:laneSet id="BP05_LaneSet">
      <bpmn:lane id="BP05_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP05_empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_do</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP05_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP05_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_reward</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_nodata</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP05_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP05_Lane2" name="Локальный ИИ">
        <bpmn:flowNodeRef>BP05_generate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP05_Lane3" name="Правила прогресса">
        <bpmn:flowNodeRef>BP05_decay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP05_s" name="Планирование заданий">
      <bpmn:outgoing>BP05_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP05_context" name="Оценить контекст и нагрузку">
      <bpmn:incoming>BP05_F1</bpmn:incoming>
      <bpmn:outgoing>BP05_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP05_generate" name="Предложить квесты">
      <bpmn:incoming>BP05_F2</bpmn:incoming>
      <bpmn:outgoing>BP05_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BP05_gate" name="Проверить срок / допустимость">
      <bpmn:incoming>BP05_F3</bpmn:incoming>
      <bpmn:outgoing>BP05_F4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="BP05_valid" name="Есть допустимое задание?" gatewayDirection="Diverging" default="BP05_F6">
      <bpmn:incoming>BP05_F4</bpmn:incoming>
      <bpmn:outgoing>BP05_F5</bpmn:outgoing>
      <bpmn:outgoing>BP05_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BP05_empty" name="Без назначения и штрафа">
      <bpmn:incoming>BP05_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BP05_assign" name="Назначить автономно">
      <bpmn:incoming>BP05_F5</bpmn:incoming>
      <bpmn:outgoing>BP05_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="BP05_do" name="Выполнить / сообщить исход">
      <bpmn:incoming>BP05_F7</bpmn:incoming>
      <bpmn:outgoing>BP05_F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BP05_outcome" name="Исход?" gatewayDirection="Diverging" default="BP05_F11">
      <bpmn:incoming>BP05_F8</bpmn:incoming>
      <bpmn:outgoing>BP05_F9</bpmn:outgoing>
      <bpmn:outgoing>BP05_F10</bpmn:outgoing>
      <bpmn:outgoing>BP05_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP05_reward" name="Начислить уникальную награду">
      <bpmn:incoming>BP05_F9</bpmn:incoming>
      <bpmn:outgoing>BP05_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BP05_decay" name="Проверить правило спада">
      <bpmn:incoming>BP05_F10</bpmn:incoming>
      <bpmn:outgoing>BP05_F13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="BP05_nodata" name="Сохранить unknown / паузу">
      <bpmn:incoming>BP05_F11</bpmn:incoming>
      <bpmn:outgoing>BP05_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP05_e" name="Прогресс обновлён">
      <bpmn:incoming>BP05_F12</bpmn:incoming>
      <bpmn:incoming>BP05_F13</bpmn:incoming>
      <bpmn:incoming>BP05_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP05_F1" sourceRef="BP05_s" targetRef="BP05_context" />
    <bpmn:sequenceFlow id="BP05_F2" sourceRef="BP05_context" targetRef="BP05_generate" />
    <bpmn:sequenceFlow id="BP05_F3" sourceRef="BP05_generate" targetRef="BP05_gate" />
    <bpmn:sequenceFlow id="BP05_F4" sourceRef="BP05_gate" targetRef="BP05_valid" />
    <bpmn:sequenceFlow id="BP05_F5" sourceRef="BP05_valid" targetRef="BP05_assign" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP05_F6" sourceRef="BP05_valid" targetRef="BP05_empty" name="нет" />
    <bpmn:sequenceFlow id="BP05_F7" sourceRef="BP05_assign" targetRef="BP05_do" />
    <bpmn:sequenceFlow id="BP05_F8" sourceRef="BP05_do" targetRef="BP05_outcome" />
    <bpmn:sequenceFlow id="BP05_F9" sourceRef="BP05_outcome" targetRef="BP05_reward" name="выполнен">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">выполнен</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP05_F10" sourceRef="BP05_outcome" targetRef="BP05_decay" name="явный пропуск">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">явный пропуск</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP05_F11" sourceRef="BP05_outcome" targetRef="BP05_nodata" name="нет данных / болезнь" />
    <bpmn:sequenceFlow id="BP05_F12" sourceRef="BP05_reward" targetRef="BP05_e" />
    <bpmn:sequenceFlow id="BP05_F13" sourceRef="BP05_decay" targetRef="BP05_e" />
    <bpmn:sequenceFlow id="BP05_F14" sourceRef="BP05_nodata" targetRef="BP05_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BP05_Diagram">
