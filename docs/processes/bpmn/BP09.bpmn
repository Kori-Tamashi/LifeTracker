<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP09_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP09" name="Закрытие месяца и поздняя корректировка" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-06</bpmn:documentation>
    <bpmn:laneSet id="BP09_LaneSet">
      <bpmn:lane id="BP09_Lane0" name="Планировщик">
        <bpmn:flowNodeRef>BP09_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_pe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP09_Lane1" name="Финансовое ядро">
        <bpmn:flowNodeRef>BP09_snapshot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_provisional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_deficit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_residual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP09_commit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP09_Lane2" name="Владелец">
        <bpmn:flowNodeRef>BP09_proposal</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP09_s" name="Новый месяц / late operation">
      <bpmn:outgoing>BP09_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP09_snapshot" name="Получить версии и сверку">
      <bpmn:incoming>BP09_F1</bpmn:incoming>
      <bpmn:outgoing>BP09_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP09_complete" name="Данные полны и свежи?" gatewayDirection="Diverging" default="BP09_F4">
      <bpmn:incoming>BP09_F2</bpmn:incoming>
      <bpmn:outgoing>BP09_F3</bpmn:outgoing>
      <bpmn:outgoing>BP09_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP09_provisional" name="Сохранить provisional">
      <bpmn:incoming>BP09_F4</bpmn:incoming>
      <bpmn:outgoing>BP09_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP09_pe" name="Ожидание данных">
      <bpmn:incoming>BP09_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="BP09_calc" name="Рассчитать остаток без дублей">
      <bpmn:incoming>BP09_F3</bpmn:incoming>
      <bpmn:outgoing>BP09_F6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="BP09_deficit" name="Есть дефицит?" gatewayDirection="Diverging" default="BP09_F8">
      <bpmn:incoming>BP09_F6</bpmn:incoming>
      <bpmn:outgoing>BP09_F7</bpmn:outgoing>
      <bpmn:outgoing>BP09_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BP09_proposal" name="Рассмотреть покрытие дефицита">
      <bpmn:incoming>BP09_F7</bpmn:incoming>
      <bpmn:outgoing>BP09_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="BP09_residual" name="Учётный резерв копилки">
      <bpmn:incoming>BP09_F8</bpmn:incoming>
      <bpmn:outgoing>BP09_F10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="BP09_commit" name="Closing / delta restatement">
      <bpmn:incoming>BP09_F9</bpmn:incoming>
      <bpmn:incoming>BP09_F10</bpmn:incoming>
      <bpmn:outgoing>BP09_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP09_e" name="История месяца согласована">
      <bpmn:incoming>BP09_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP09_F1" sourceRef="BP09_s" targetRef="BP09_snapshot" />
    <bpmn:sequenceFlow id="BP09_F2" sourceRef="BP09_snapshot" targetRef="BP09_complete" />
    <bpmn:sequenceFlow id="BP09_F3" sourceRef="BP09_complete" targetRef="BP09_calc" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP09_F4" sourceRef="BP09_complete" targetRef="BP09_provisional" name="нет" />
    <bpmn:sequenceFlow id="BP09_F5" sourceRef="BP09_provisional" targetRef="BP09_pe" />
    <bpmn:sequenceFlow id="BP09_F6" sourceRef="BP09_calc" targetRef="BP09_deficit" />
    <bpmn:sequenceFlow id="BP09_F7" sourceRef="BP09_deficit" targetRef="BP09_proposal" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP09_F8" sourceRef="BP09_deficit" targetRef="BP09_residual" name="нет" />
    <bpmn:sequenceFlow id="BP09_F9" sourceRef="BP09_proposal" targetRef="BP09_commit" name="решение / сохранить дефицит" />
    <bpmn:sequenceFlow id="BP09_F10" sourceRef="BP09_residual" targetRef="BP09_commit" />
    <bpmn:sequenceFlow id="BP09_F11" sourceRef="BP09_commit" targetRef="BP09_e" />
  </bpmn:process>
