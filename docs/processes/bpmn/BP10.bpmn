<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP10_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP10" name="Импорт источника и checkpoint" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-02, ALG-11</bpmn:documentation>
    <bpmn:laneSet id="BP10_LaneSet">
      <bpmn:lane id="BP10_Lane0" name="Адаптер">
        <bpmn:flowNodeRef>BP10_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_qualified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP10_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP10_normalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_dedup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP10_refresh</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP10_Lane2" name="Хранилище">
        <bpmn:flowNodeRef>BP10_commit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP10_s" name="Автоматический batch">
      <bpmn:outgoing>BP10_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="BP10_qualified" name="Источник допущен?" gatewayDirection="Diverging" default="BP10_F3">
      <bpmn:incoming>BP10_F1</bpmn:incoming>
      <bpmn:outgoing>BP10_F2</bpmn:outgoing>
      <bpmn:outgoing>BP10_F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BP10_stop" name="Capability unavailable">
      <bpmn:incoming>BP10_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BP10_normalize" name="Нормализовать IDs / units">
      <bpmn:incoming>BP10_F2</bpmn:incoming>
      <bpmn:outgoing>BP10_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP10_validate" name="Batch корректен?" gatewayDirection="Diverging" default="BP10_F6">
      <bpmn:incoming>BP10_F4</bpmn:incoming>
      <bpmn:outgoing>BP10_F5</bpmn:outgoing>
      <bpmn:outgoing>BP10_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BP10_retry" name="Сохранить ошибку / retry">
      <bpmn:incoming>BP10_F6</bpmn:incoming>
      <bpmn:outgoing>BP10_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP10_re" name="Checkpoint не продвинут">
      <bpmn:incoming>BP10_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="BP10_dedup" name="Сверить версии и дубли">
      <bpmn:incoming>BP10_F5</bpmn:incoming>
      <bpmn:outgoing>BP10_F8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="BP10_commit" name="Commit records + cursor + outbox">
      <bpmn:incoming>BP10_F8</bpmn:incoming>
      <bpmn:outgoing>BP10_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP10_refresh" name="Обновить проекции / freshness">
      <bpmn:incoming>BP10_F9</bpmn:incoming>
      <bpmn:outgoing>BP10_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP10_e" name="Batch принят ровно логически">
      <bpmn:incoming>BP10_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP10_F1" sourceRef="BP10_s" targetRef="BP10_qualified" />
    <bpmn:sequenceFlow id="BP10_F2" sourceRef="BP10_qualified" targetRef="BP10_normalize" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP10_F3" sourceRef="BP10_qualified" targetRef="BP10_stop" name="нет" />
    <bpmn:sequenceFlow id="BP10_F4" sourceRef="BP10_normalize" targetRef="BP10_validate" />
    <bpmn:sequenceFlow id="BP10_F5" sourceRef="BP10_validate" targetRef="BP10_dedup" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP10_F6" sourceRef="BP10_validate" targetRef="BP10_retry" name="нет" />
    <bpmn:sequenceFlow id="BP10_F7" sourceRef="BP10_retry" targetRef="BP10_re" />
    <bpmn:sequenceFlow id="BP10_F8" sourceRef="BP10_dedup" targetRef="BP10_commit" />
    <bpmn:sequenceFlow id="BP10_F9" sourceRef="BP10_commit" targetRef="BP10_refresh" />
    <bpmn:sequenceFlow id="BP10_F10" sourceRef="BP10_refresh" targetRef="BP10_e" />
  </bpmn:process>
