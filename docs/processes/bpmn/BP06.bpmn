<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP06_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP06" name="Напоминания и доставка в два канала" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-08</bpmn:documentation>
    <bpmn:laneSet id="BP06_LaneSet">
      <bpmn:lane id="BP06_Lane0" name="Планировщик">
        <bpmn:flowNodeRef>BP06_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_limited</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP06_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP06_fresh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_quiet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_quota</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP06_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP06_Lane2" name="Канальные адаптеры">
        <bpmn:flowNodeRef>BP06_send</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP06_s" name="Готов trigger">
      <bpmn:outgoing>BP06_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="BP06_fresh" name="Trigger актуален?" gatewayDirection="Diverging" default="BP06_F3">
      <bpmn:incoming>BP06_F1</bpmn:incoming>
      <bpmn:incoming>BP06_F6</bpmn:incoming>
      <bpmn:outgoing>BP06_F2</bpmn:outgoing>
      <bpmn:outgoing>BP06_F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BP06_expired" name="Истёк без доставки">
      <bpmn:incoming>BP06_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="BP06_quiet" name="Тихие часы?" gatewayDirection="Diverging" default="BP06_F5">
      <bpmn:incoming>BP06_F2</bpmn:incoming>
      <bpmn:outgoing>BP06_F4</bpmn:outgoing>
      <bpmn:outgoing>BP06_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="BP06_wait" name="Дождаться разрешённого времени">
      <bpmn:incoming>BP06_F4</bpmn:incoming>
      <bpmn:outgoing>BP06_F6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BP06_wait_Timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${next_allowed_at}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="BP06_quota" name="Проверить причину и квоту">
      <bpmn:incoming>BP06_F5</bpmn:incoming>
      <bpmn:outgoing>BP06_F7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="BP06_allowed" name="Отправка допустима?" gatewayDirection="Diverging" default="BP06_F9">
      <bpmn:incoming>BP06_F7</bpmn:incoming>
      <bpmn:outgoing>BP06_F8</bpmn:outgoing>
      <bpmn:outgoing>BP06_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BP06_limited" name="Пропуск / объединение">
      <bpmn:incoming>BP06_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BP06_reserve" name="Событие + слот + Delivery">
      <bpmn:incoming>BP06_F8</bpmn:incoming>
      <bpmn:outgoing>BP06_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP06_send" name="Доставить в macOS и Telegram">
      <bpmn:incoming>BP06_F10</bpmn:incoming>
      <bpmn:outgoing>BP06_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP06_result" name="Записать исходы / retry">
      <bpmn:incoming>BP06_F11</bpmn:incoming>
      <bpmn:outgoing>BP06_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP06_e" name="Доставки учтены">
      <bpmn:incoming>BP06_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP06_F1" sourceRef="BP06_s" targetRef="BP06_fresh" />
    <bpmn:sequenceFlow id="BP06_F2" sourceRef="BP06_fresh" targetRef="BP06_quiet" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP06_F3" sourceRef="BP06_fresh" targetRef="BP06_expired" name="нет" />
    <bpmn:sequenceFlow id="BP06_F4" sourceRef="BP06_quiet" targetRef="BP06_wait" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP06_F5" sourceRef="BP06_quiet" targetRef="BP06_quota" name="нет" />
    <bpmn:sequenceFlow id="BP06_F6" sourceRef="BP06_wait" targetRef="BP06_fresh" name="проверить заново" />
    <bpmn:sequenceFlow id="BP06_F7" sourceRef="BP06_quota" targetRef="BP06_allowed" />
    <bpmn:sequenceFlow id="BP06_F8" sourceRef="BP06_allowed" targetRef="BP06_reserve" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP06_F9" sourceRef="BP06_allowed" targetRef="BP06_limited" name="нет" />
    <bpmn:sequenceFlow id="BP06_F10" sourceRef="BP06_reserve" targetRef="BP06_send" />
    <bpmn:sequenceFlow id="BP06_F11" sourceRef="BP06_send" targetRef="BP06_result" />
    <bpmn:sequenceFlow id="BP06_F12" sourceRef="BP06_result" targetRef="BP06_e" />
  </bpmn:process>
