<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BP04_Definitions" targetNamespace="https://lifetracker.local/processes" exporter="LifeTracker process builder" exporterVersion="0.1">
  <bpmn:process id="BP04" name="Месячный бюджет и разбор" isExecutable="false">
    <bpmn:documentation>Design model; proposed rules; algorithms ALG-06, ALG-11</bpmn:documentation>
    <bpmn:laneSet id="BP04_LaneSet">
      <bpmn:lane id="BP04_Lane0" name="Владелец">
        <bpmn:flowNodeRef>BP04_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP04_Lane1" name="Ядро">
        <bpmn:flowNodeRef>BP04_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_norm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_view</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="BP04_Lane2" name="Банковский адаптер">
        <bpmn:flowNodeRef>BP04_fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BP04_blocked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="BP04_s" name="План / обновление месяца">
      <bpmn:outgoing>BP04_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="BP04_fetch" name="Получить операции автоматически">
      <bpmn:incoming>BP04_F1</bpmn:incoming>
      <bpmn:outgoing>BP04_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BP04_avail" name="Источник доступен?" gatewayDirection="Diverging" default="BP04_F4">
      <bpmn:incoming>BP04_F2</bpmn:incoming>
      <bpmn:outgoing>BP04_F3</bpmn:outgoing>
      <bpmn:outgoing>BP04_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BP04_blocked" name="Финансовый этап отложен">
      <bpmn:incoming>BP04_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="BP04_norm" name="Сверить переводы и версии">
      <bpmn:incoming>BP04_F3</bpmn:incoming>
      <bpmn:outgoing>BP04_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="BP04_plan" name="Задать / пересмотреть план">
      <bpmn:incoming>BP04_F5</bpmn:incoming>
      <bpmn:outgoing>BP04_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="BP04_calc" name="Посчитать план / факт / резервы">
      <bpmn:incoming>BP04_F6</bpmn:incoming>
      <bpmn:outgoing>BP04_F7</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="BP04_change" name="Нужно изменить план?" gatewayDirection="Diverging" default="BP04_F9">
      <bpmn:incoming>BP04_F7</bpmn:incoming>
      <bpmn:outgoing>BP04_F8</bpmn:outgoing>
      <bpmn:outgoing>BP04_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="BP04_approve" name="Подтвердить новое распределение">
      <bpmn:incoming>BP04_F8</bpmn:incoming>
      <bpmn:outgoing>BP04_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="BP04_store" name="Сохранить принятый план">
      <bpmn:incoming>BP04_F10</bpmn:incoming>
      <bpmn:outgoing>BP04_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="BP04_view" name="Показать разбор и остатки">
      <bpmn:incoming>BP04_F9</bpmn:incoming>
      <bpmn:incoming>BP04_F11</bpmn:incoming>
      <bpmn:outgoing>BP04_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BP04_e" name="Обзор месяца доступен">
      <bpmn:incoming>BP04_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="BP04_F1" sourceRef="BP04_s" targetRef="BP04_fetch" />
    <bpmn:sequenceFlow id="BP04_F2" sourceRef="BP04_fetch" targetRef="BP04_avail" />
    <bpmn:sequenceFlow id="BP04_F3" sourceRef="BP04_avail" targetRef="BP04_norm" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP04_F4" sourceRef="BP04_avail" targetRef="BP04_blocked" name="нет" />
    <bpmn:sequenceFlow id="BP04_F5" sourceRef="BP04_norm" targetRef="BP04_plan" />
    <bpmn:sequenceFlow id="BP04_F6" sourceRef="BP04_plan" targetRef="BP04_calc" />
    <bpmn:sequenceFlow id="BP04_F7" sourceRef="BP04_calc" targetRef="BP04_change" />
    <bpmn:sequenceFlow id="BP04_F8" sourceRef="BP04_change" targetRef="BP04_approve" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="BP04_F9" sourceRef="BP04_change" targetRef="BP04_view" name="нет" />
    <bpmn:sequenceFlow id="BP04_F10" sourceRef="BP04_approve" targetRef="BP04_store" />
    <bpmn:sequenceFlow id="BP04_F11" sourceRef="BP04_store" targetRef="BP04_view" />
    <bpmn:sequenceFlow id="BP04_F12" sourceRef="BP04_view" targetRef="BP04_e" />
  </bpmn:process>
